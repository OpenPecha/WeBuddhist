server {
  listen 4173;
  server_name localhost;
  proxy_http_version 1.1;

  # Avoid leaking internal port 4173 in redirects when behind a reverse proxy
  absolute_redirect off;
  port_in_redirect off;

  root /usr/share/nginx/html;
  index index.html;

  # App deep link landing page — serve without trailing-slash redirect
  location = /open {
    try_files /open/index.html =404;
    include /etc/nginx/security-headers.conf;
  }

  location / {
    try_files $uri $uri/ /index.html;
    include /etc/nginx/security-headers.conf;
  }

  location /api {
    proxy_pass ${VITE_BACKEND_BASE_URL};
    proxy_ssl_server_name on;
  }

  location ~ ^/(chats|threads)(/|$) {
    proxy_pass ${VITE_CHAT_API_URL};
    proxy_ssl_server_name on;

    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_ssl_verify off;

    # For streaming responses
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_connect_timeout 75s;
  }
}
